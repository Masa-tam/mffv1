# Keep repository text files stable across Windows and POSIX checkouts.
* text=auto eol=lf

# Build, source, and documentation files are text.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
CMakePresets.json text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# Binary assets and generated media must not be line-ending normalized.
*.avi binary
*.bin binary
*.dll binary
*.exe binary
*.gz binary
*.ico binary
*.jpg binary
*.jpeg binary
*.lib binary
*.mkv binary
*.mov binary
*.mp4 binary
*.pdb binary
*.png binary
*.tar binary
*.webp binary
*.xz binary
*.zip binary
